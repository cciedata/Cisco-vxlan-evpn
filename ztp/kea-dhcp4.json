{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": ["br-ztp"],
      "dhcp-socket-type": "raw",
      "service-sockets-max-retries": 200,
      "service-sockets-retry-wait-time": 3000
    },
    "lease-database": {"type": "memfile", "persist": false},
    "valid-lifetime": 3600,
    "subnet4": [
      {
        "id": 1,
        "subnet": "__ZTP_SUBNET__",
        "pools": [{"pool": "__ZTP_POOL__"}],
        "option-data": [
          {"name": "routers", "data": "__ZTP_SERVER_IP__"},
          {"name": "tftp-server-name", "data": "http://__ZTP_SERVER_IP__:8080"},
          {"name": "boot-file-name", "data": "poap.py"}
        ]
      }
    ],
    "loggers": [{"name": "kea-dhcp4", "output-options": [{"output": "stdout"}], "severity": "INFO"}]
  }
}
