{# Option 5 lab: stand-in for one SD-WAN branch behind carrier B, rendered from the hub's data (same query as
   sdwan_fw_config.j2): the hub's WAN loopback and overlay /21 come from the graph; the branch's own values are lab-only.
   GRE stands in for the ADVPN 2.0 IPsec spoke; iBGP in sdwan_overlay_asn to the hub's overlay address; one branch LAN announced.
   WAN MTU: mtu_external. #}
{%- if data.FabricDesign.count != 1 %}{{ missing_FabricDesign_object() }}{% endif -%}
{%- set fd = data.FabricDesign.edges[0].node -%}
{%- if fd.sdwan_overlay_asn.value is none %}{{ missing_FabricDesign_sdwan_overlay_asn() }}{% endif -%}
{%- if fd.sdwan_branch_bgp_password.value is none %}{{ missing_FabricDesign_sdwan_branch_bgp_password() }}{% endif -%}
{%- if fd.sdwan_overlay_pool_start_offset.value is none %}{{ missing_FabricDesign_sdwan_overlay_pool_start_offset() }}{% endif -%}
{%- if fd.mtu_external.value is none %}{{ missing_FabricDesign_mtu_external() }}{% endif -%}
{# wan_lo / tunnel: the hub's interfaces whose addresses lie in dc*_sdwan_fw_wan_endpoint / dc*_sdwan_overlay (read below) #}
{% set overlay_asn = fd.sdwan_overlay_asn.value -%}
{% set bgp_password = fd.sdwan_branch_bgp_password.value -%}
{% set mtu = fd.mtu_external.value -%}
{% set branch_wan = "198.18.3.10/24" -%}{# lab-only: carrier B's branch subnet 198.18.3.0/24, branch .10 #}
{% set branch_wan_gw = "198.18.3.254" -%}{# lab-only: carrier side .254 #}
{% set branch_lan = "10.64.1.1/24" -%}{# lab-only: inside the branch range 10.64.0.0/12 le 24 #}
{% set spoke_offset = fd.sdwan_overlay_pool_start_offset.value -%}{# lab-only: first address of the hub's mode-cfg pool = hub tunnel + 1 #}
{# Values from the graph #}
{% set device = data.DcimDevice.edges[0].node -%}
{% set name = device.name.value -%}
{% set site_name = device.location.node.name.value -%}
{% set wep_key = site_name | lower ~ "_sdwan_fw_wan_endpoint" -%}
{% set ovl_key = site_name | lower ~ "_sdwan_overlay" -%}
{%- if fd[wep_key] is not defined or fd[wep_key].value is none %}{{ fd["missing_FabricDesign_" ~ wep_key].value() }}{% endif -%}
{%- if fd[ovl_key] is not defined or fd[ovl_key].value is none %}{{ fd["missing_FabricDesign_" ~ ovl_key].value() }}{% endif -%}
{% set wep = fd[wep_key].value -%}
{% set ovl = fd[ovl_key].value -%}
{% set unit_ns = namespace(wan=none, tun=none, wan_name=none, tun_name=none) -%}
{% for u in data.SdwanUnits.edges | map(attribute="node") | list | selectattr("location.node.name.value", "equalto", site_name) | list %}{% for i in u.interfaces.edges | map(attribute="node") | list %}{% if i.ip_addresses is defined and i.ip_addresses.edges %}{% set a = i.ip_addresses.edges[0].node.address.value %}{% if ((a.split("/")[0] ~ "/" ~ wep.split("/")[1]) | ipaddress_interface("network") | string) == wep %}{% set unit_ns.wan = a %}{% set unit_ns.wan_name = i.name.value %}{% elif ((a.split("/")[0] ~ "/" ~ ovl.split("/")[1]) | ipaddress_interface("network") | string) == ovl %}{% set unit_ns.tun = a %}{% set unit_ns.tun_name = i.name.value %}{% endif %}{% endif %}{% endfor %}{% endfor -%}
{%- if unit_ns.wan_name is none %}{{ fd["missing_interface_in_" ~ wep_key].value() }}{% endif -%}
{%- if unit_ns.tun_name is none %}{{ fd["missing_interface_in_" ~ ovl_key].value() }}{% endif -%}
{% set wan_lo = unit_ns.wan_name -%}
{% set tunnel = unit_ns.tun_name -%}
{% set hub_wan = unit_ns.wan | ipaddress_interface("ip") | string -%}
{% set hub_tun = unit_ns.tun | ipaddress_interface("ip") | string -%}
{% set plen = unit_ns.tun | ipaddress_interface("network") | string -%}
{% set o = hub_tun.split(".") -%}
{% set spoke_tun = o[:3] | join(".") ~ "." ~ ((o[3] | int) + spoke_offset) -%}
#!/bin/sh
# {{ site_name }}-BRANCH1: lab stand-in for an SD-WAN branch of hub {{ name[:-1] }} (FRR in a Linux container). Rendered by Infrahub
# from {{ name }}'s data, do not edit. Interface "wan" toward carrier B. Lab-only: GRE instead of ADVPN IPsec.
set -eu
sysctl -qw net.ipv4.ip_forward=1
ip route del default dev eth0 2>/dev/null || true
ip link set wan mtu {{ mtu }} up
ip addr replace {{ branch_wan }} dev wan
ip route replace default via {{ branch_wan_gw }} dev wan
ip link add LAN type dummy 2>/dev/null || true
ip addr replace {{ branch_lan }} dev LAN
ip link set LAN up
ip tunnel add {{ tunnel }} mode gre local {{ branch_wan.split("/")[0] }} remote {{ hub_wan }} ttl 64 2>/dev/null || true
ip addr replace {{ spoke_tun }}/{{ plen.split("/")[1] }} dev {{ tunnel }}
ip link set {{ tunnel }} up
pgrep -x bgpd >/dev/null || /usr/lib/frr/bgpd -d -A 127.0.0.1
sleep 2
cat > /etc/frr/frr.conf <<'FRREOF'
hostname {{ site_name }}-BRANCH1
service integrated-vtysh-config
!
router bgp {{ overlay_asn }}
 bgp router-id {{ spoke_tun }}
 no bgp ebgp-requires-policy
 neighbor {{ hub_tun }} remote-as {{ overlay_asn }}
 neighbor {{ hub_tun }} description {{ name[:-1] }} hub
 neighbor {{ hub_tun }} password {{ bgp_password }}
 address-family ipv4 unicast
  network {{ branch_lan | ipaddress_interface("network") }}
 exit-address-family
exit
FRREOF
vtysh -f /etc/frr/frr.conf
echo "{{ site_name }}-BRANCH1 stand-in ready"
