{# Lab stand-in for the carrier behind one ISP router, as one POSIX shell script run in an FRR
   container (containerlab exec). Rendered per ISP router from the same query as its IOS XR config: the carrier side of the
   carrier link (carrier_side_host), the provider's ASN, our router's address and ASN. The carrier originates 0/0 and its
   internet host subnet. Lab subnets are keyed by the carrier_names entry of the facing carrier. #}
{# Constants: carrier session values match isp_router_config.j2; the rest are lab-only values #}
{%- if data.FabricDesign.count != 1 %}{{ missing_FabricDesign_object() }}{% endif -%}
{%- set fd = data.FabricDesign.edges[0].node -%}
{%- if fd.isp_carrier_bgp_password.value is none %}{{ missing_FabricDesign_isp_carrier_bgp_password() }}{% endif -%}
{%- if fd.bfd_interval_ms.value is none %}{{ missing_FabricDesign_bfd_interval_ms() }}{% endif -%}
{%- if fd.bfd_multiplier.value is none %}{{ missing_FabricDesign_bfd_multiplier() }}{% endif -%}
{%- if fd.bfd_min_rx_ms.value is none %}{{ missing_FabricDesign_bfd_min_rx_ms() }}{% endif -%}
{%- if fd.carrier_side_host.value is none %}{{ missing_FabricDesign_carrier_side_host() }}{% endif -%}
{%- if fd.mtu_external.value is none %}{{ missing_FabricDesign_mtu_external() }}{% endif -%}
{%- if fd.carrier_names.value is none %}{{ missing_FabricDesign_carrier_names() }}{% endif -%}
{%- if fd.isp_carrier_bgp_bfd.value is none %}{{ missing_FabricDesign_isp_carrier_bgp_bfd() }}{% endif -%}
{% set bgp_password = fd.isp_carrier_bgp_password.value -%}
{% set bfd_tx = fd.bfd_interval_ms.value -%}{% set bfd_rx = fd.bfd_min_rx_ms.value -%}{% set bfd_mult = fd.bfd_multiplier.value -%}
{% set carrier_host = fd.carrier_side_host.value -%}
{% set mtu = fd.mtu_external.value -%}
{% set bfd_profile = "CARRIER-BFD" -%}{# BFD profile name used in this lab script #}
{% set host_net = {"1": "198.18.1.0/24", "2": "198.18.2.0/24"} -%}{# keyed by carrier_names; RFC 2544 range (198.51.100.0/24 is DC1's own public /24) #}
{% set host_gw = 1 -%}
{% set wan_net = {"1": "198.18.100.0/24", "2": "198.18.3.0/24"} -%}{# option 5 lab: optional port "wan" toward the VPN partner (carrier 1) or the SD-WAN branch (carrier 2); keyed by carrier_names #}
{% set wan_gw = 254 -%}{# option 5 lab: carrier side of the wan subnet #}{# host .10, carrier .1 #}
{# Values from the graph #}
{% set device = data.DcimDevice.edges[0].node -%}
{% set name = device.name.value -%}
{% set site_name = device.location.node.name.value -%}
{% set our_asn = device.asn.node.asn.value -%}
{% set interfaces = device.interfaces.edges | map(attribute="node") | list -%}
{% set carrier = interfaces | selectattr("__typename", "equalto", "InterfacePhysical") | selectattr("role.value", "equalto", "upstream") | list | first -%}
{% set pns = namespace(asn=none, name=none) -%}
{% for a in data.ProviderAsns.edges | map(attribute="node") | list %}{% if a.provider.node is not none and carrier.description.value.startswith(a.provider.node.name.value ~ " ") %}{% set pns.asn = a.asn.value %}{% set pns.name = a.provider.node.name.value %}{% endif %}{% endfor -%}
{% macro host(p, n) %}{% set o = p.split("/")[0].split(".") %}{{ o[:3] | join(".") }}.{{ o[3] | int + n }}/{{ p.split("/")[1] }}{% endmacro -%}
{% set our_addr = carrier.ip_addresses.edges[0].node.address.value -%}
{% set link_net = our_addr | ipaddress_interface("network") | string -%}
{% set carrier_addr = host(link_net, carrier_host) -%}
{% set our_ip = our_addr | ipaddress_interface("ip") -%}
{% set cn = namespace(key=none) -%}
{% for k, v in fd.carrier_names.value | dictsort %}{% if v == pns.name %}{% set cn.key = k %}{% endif %}{% endfor -%}
{%- if cn.key is none or cn.key not in host_net or cn.key not in wan_net %}{{ fd["missing_FabricDesign_carrier_names_entry_for_" ~ pns.name].value() }}{% endif -%}
{% set hnet = host_net[cn.key] -%}
{% set isp_mtu = carrier.mtu.value -%}{# MTU of the ISP router's carrier port this port faces #}
#!/bin/sh
# {{ site_name }}-{{ pns.name }}: lab stand-in for carrier {{ pns.name }} (AS {{ pns.asn }}) facing {{ name }} {{ carrier.name.value }}.
# Rendered by Infrahub from {{ name }}'s data, do not edit. Interfaces: "isp" toward {{ name }}, "host" toward the internet test host.
set -eu
sysctl -qw net.ipv4.ip_forward=1
ip link set isp mtu {{ isp_mtu }} up
ip addr replace {{ carrier_addr }} dev isp
ip link set host up
ip addr replace {{ host(hnet, host_gw) }} dev host
{% set wnet = wan_net[cn.key] %}
if [ -e /sys/class/net/wan ]; then ip link set wan mtu {{ mtu }} up; ip addr replace {{ host(wnet, wan_gw) }} dev wan; fi
pgrep -x bfdd >/dev/null || /usr/lib/frr/bfdd -d -A 127.0.0.1
pgrep -x bgpd >/dev/null || /usr/lib/frr/bgpd -d -A 127.0.0.1
sleep 2
cat > /etc/frr/frr.conf <<'FRREOF'
hostname {{ site_name }}-{{ pns.name }}
service integrated-vtysh-config
!
bfd
 profile {{ bfd_profile }}
  transmit-interval {{ bfd_tx }}
  receive-interval {{ bfd_rx }}
  detect-multiplier {{ bfd_mult }}
  no echo-mode
 exit
exit
!
router bgp {{ pns.asn }}
 bgp router-id {{ carrier_addr | ipaddress_interface("ip") }}
 no bgp ebgp-requires-policy
 neighbor {{ our_ip }} remote-as {{ our_asn }}
 neighbor {{ our_ip }} description {{ name }}
 neighbor {{ our_ip }} password {{ bgp_password }}
{% if fd.isp_carrier_bgp_bfd.value %}
 neighbor {{ our_ip }} bfd profile {{ bfd_profile }}
{% endif %}
 address-family ipv4 unicast
  network {{ hnet }}
  network {{ wnet }}
  neighbor {{ our_ip }} default-originate
 exit-address-family
exit
FRREOF
vtysh -f /etc/frr/frr.conf
echo "{{ site_name }}-{{ pns.name }} stand-in ready"
