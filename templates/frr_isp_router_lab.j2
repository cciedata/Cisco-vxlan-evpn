{# Phase 3 (I-04..I-20, decisions.xlsx sheet Auto-approved-ISPFRR): lab stand-in for an IOS XR ISP router, as one POSIX shell
   script run in an FRR container (containerlab exec), same pattern as frr_internet_fw_lab.j2. Rendered from the same query as
   isp_router_config.j2 and mirrors its routing: eBGP to the carrier and to the Internet FW, iBGP over the cross-link, BFD
   999 x 3, the prefix-sets and route-policies, the conditional default, the static routes. Keep in step with isp_router_config.j2. #}
{# Approved constants: same values as isp_router_config.j2 (PC2/PC3 decisions); lab-only values (I-xx) marked #}
{% set bgp_password = "cisco123" -%}
{% set bfd_interval = 999 -%}{% set bfd_mult = 3 -%}
{% set max_prefix = 1200000 -%}{% set max_prefix_pct = 90 -%}
{% set inetfw_host = 10 -%}
{% set wan_fw_host = {"sdwan_fw": 11, "vpn_fw": 12} -%}
{% set carrier_host = 1 -%}
{% set seq_step = 10 -%}
{% set bfd_profile = "ISP-BFD" -%}{# I-18 #}
{% set bond_mode = "802.3ad" -%}{# I-10: IOS XR 'bundle id .. mode active' is LACP #}
{% set lab_port_from = "FourHundredGigE0/0/0/" -%}{# I-08: P3-70 rule, FH0/0/0/<2k> -> Gi0-0-0-<k> (the containerlab port name) #}
{% macro lx(n) %}{% if n.startswith(lab_port_from) %}Gi0-0-0-{{ (n.split("/")[-1] | int) // 2 }}{% else %}{{ n }}{% endif %}{% endmacro -%}
{% macro be(n) %}{{ n | replace("Bundle-Ether", "BE") }}{% endmacro -%}{# I-09: Linux names are at most 15 characters #}
{# Values from the graph #}
{% set device = data.DcimDevice.edges[0].node -%}
{% set name = device.name.value -%}
{% set asn = device.asn.node.asn.value -%}
{% set site = device.location.node -%}
{% set site_name = site.name.value -%}
{% set interfaces = device.interfaces.edges | map(attribute="node") | list -%}
{% set physical = interfaces | selectattr("__typename", "equalto", "InterfacePhysical") | list -%}
{% set virtual = interfaces | selectattr("__typename", "equalto", "InterfaceVirtual") | list -%}
{% set lo0 = virtual | selectattr("name.value", "equalto", "loopback0") | list | first -%}
{% set bundle = interfaces | selectattr("__typename", "equalto", "InterfacePortChannel") | list | first -%}
{% set members = physical | selectattr("role.value", "equalto", "peering") | list | sort(attribute="name.value") -%}
{% set subif = virtual | selectattr("role.value", "equalto", "peering") | list | first -%}
{% set xlink = physical | selectattr("role.value", "equalto", "core") | list | first -%}
{% set carrier = physical | selectattr("role.value", "equalto", "upstream") | list | first -%}
{% set pns = namespace(asn=none, name=none) -%}
{% for a in data.ProviderAsns.edges | map(attribute="node") | list %}{% if a.provider.node is not none and carrier.description.value.startswith(a.provider.node.name.value ~ " ") %}{% set pns.asn = a.asn.value %}{% set pns.name = a.provider.node.name.value %}{% endif %}{% endfor -%}
{% set inetfw = data.InternetFws.edges | map(attribute="node") | list | selectattr("location.node.name.value", "equalto", site_name) | list | first -%}
{% set pub_ns = namespace(items=[]) -%}
{% for p in site.owned_prefixes.edges | map(attribute="node.prefix.value") | list %}{% if not p.startswith("10.") and (p.split("/")[1] | int) <= 27 %}{% set pub_ns.items = pub_ns.items + [p] %}{% endif %}{% endfor -%}
{% set pfx = namespace(p24=none, p25=none, p27=none) -%}
{% for p in pub_ns.items %}{% set l = p.split("/")[1] %}{% if l == "24" %}{% set pfx.p24 = p %}{% elif l == "25" %}{% set pfx.p25 = p %}{% elif l == "27" %}{% set pfx.p27 = p %}{% endif %}{% endfor -%}
{# Values derived by rule (same rules as isp_router_config.j2) #}
{% macro host(addr, h) %}{% set o = (addr | ipaddress_interface("network") | string).split("/")[0].split(".") %}{{ o[:3] | join(".") }}.{{ o[3] | int + h }}{% endmacro -%}
{% set sub_addr = subif.ip_addresses.edges[0].node.address.value -%}
{% set vlan = subif.name.value.split(".")[1] -%}
{% set bond = be(bundle.name.value) -%}
{% set vif = be(subif.name.value) -%}
{% set xlink_addr = xlink.ip_addresses.edges[0].node.address.value -%}
{% set xlink_ip = xlink_addr | ipaddress_interface("ip") | string -%}
{% set xo = xlink_ip.split(".") -%}
{% set ibgp_peer = xo[:3] | join(".") ~ "." ~ ((xo[3] | int) + (1 if (xo[3] | int) % 2 == 0 else -1)) -%}
{% set carrier_addr = carrier.ip_addresses.edges[0].node.address.value -%}
{% set carrier_peer = host(carrier_addr, carrier_host) -%}
{% set inetfw_ip = host(sub_addr, inetfw_host) -%}
{% set wan_fws = (data.SdwanFws.edges + data.VpnFws.edges) | map(attribute="node") | list -%}
{% set wan_ns = namespace(routes=[]) -%}
{% for f in wan_fws | selectattr("location.node.name.value", "equalto", site_name) | list | sort(attribute="name.value") %}{% for i in f.interfaces.edges | map(attribute="node") | list %}{% for a in i.ip_addresses.edges | map(attribute="node.address.value") | list %}{% set wan_ns.routes = wan_ns.routes + [(a | ipaddress_interface("network") | string, host(sub_addr, wan_fw_host[f.role.value]))] %}{% endfor %}{% endfor %}{% endfor -%}
{% set router_id = lo0.ip_addresses.edges[0].node.address.value | ipaddress_interface("ip") -%}
#!/bin/sh
# {{ name }}: lab stand-in for the IOS XR ISP router (FRR in a Linux container). Rendered by Infrahub, do not edit.
# Mirrors the IOS XR routing config. Not mirrored: the management VRF (the container's eth0; its default route is removed so
# 0.0.0.0/0 in the routing table comes only from BGP), VRRP (FRR vrrpd has no preempt delay or interface tracking; no lab node uses the VIP).
# Port names: {% for m in members %}{{ m.name.value }} -> {{ lx(m.name.value) }}, {% endfor %}{{ xlink.name.value }} -> {{ lx(xlink.name.value) }}, {{ carrier.name.value }} -> {{ lx(carrier.name.value) }}, {{ bundle.name.value }} -> {{ bond }}.
set -eu
sysctl -qw net.ipv4.ip_forward=1
ip route del default dev eth0 2>/dev/null || true
# --- Loopback0
ip addr replace {{ router_id }}/32 dev lo
# --- {{ bundle.name.value }} (LACP; members that exist in the lab) and its sub-interface {{ subif.name.value }}
ip link add {{ bond }} type bond mode {{ bond_mode }} 2>/dev/null || true
{% for m in members %}
if [ -e /sys/class/net/{{ lx(m.name.value) }} ]; then ip link set {{ lx(m.name.value) }} down; ip link set {{ lx(m.name.value) }} mtu {{ m.mtu.value }}; ip link set {{ lx(m.name.value) }} master {{ bond }}; ip link set {{ lx(m.name.value) }} up; fi
{% endfor %}
ip link set {{ bond }} mtu {{ bundle.mtu.value }} up
ip link add link {{ bond }} name {{ vif }} type vlan id {{ vlan }} 2>/dev/null || true
ip addr replace {{ sub_addr }} dev {{ vif }}
ip link set {{ vif }} mtu {{ bundle.mtu.value }} up
# --- cross-link {{ xlink.name.value }} and carrier link {{ carrier.name.value }}
{% for i in [xlink, carrier] %}
if [ -e /sys/class/net/{{ lx(i.name.value) }} ]; then ip link set {{ lx(i.name.value) }} mtu {{ i.mtu.value }}; ip addr replace {{ i.ip_addresses.edges[0].node.address.value }} dev {{ lx(i.name.value) }}; ip link set {{ lx(i.name.value) }} up; fi
{% endfor %}
# --- routing daemons (watchfrr starts zebra and staticd; bgpd and bfdd are started here)
pgrep -x bfdd >/dev/null || /usr/lib/frr/bfdd -d -A 127.0.0.1
pgrep -x bgpd >/dev/null || /usr/lib/frr/bgpd -d -A 127.0.0.1
sleep 2
cat > /etc/frr/frr.conf <<'FRREOF'
hostname {{ name }}
service integrated-vtysh-config
!
ip route {{ pfx.p24 }} blackhole
ip route {{ pfx.p25 }} {{ inetfw_ip }}
ip route {{ pfx.p27 }} {{ inetfw_ip }}
{% for net, nh in wan_ns.routes %}
ip route {{ net }} {{ nh }}
{% endfor %}
!
ip prefix-list PL-OWN-PUBLIC seq {{ seq_step }} permit {{ pfx.p24 }}
ip prefix-list PL-DEFAULT seq {{ seq_step }} permit 0.0.0.0/0
!
bgp as-path access-list AS-LOCAL seq {{ seq_step }} permit ^$
!
route-map RM-CARRIER-IN permit {{ seq_step }}
route-map RM-CARRIER-OUT permit {{ seq_step }}
 match ip address prefix-list PL-OWN-PUBLIC
 match as-path AS-LOCAL
route-map RM-INETFW-IN permit {{ seq_step }}
 match ip address prefix-list PL-OWN-PUBLIC
route-map RM-INETFW-OUT deny {{ seq_step }}
route-map RM-COND-DEFAULT permit {{ seq_step }}
 match ip address prefix-list PL-DEFAULT
!
bfd
 profile {{ bfd_profile }}
  transmit-interval {{ bfd_interval }}
  receive-interval {{ bfd_interval }}
  detect-multiplier {{ bfd_mult }}
  no echo-mode
 exit
exit
!
router bgp {{ asn }}
 bgp router-id {{ router_id }}
 bgp graceful-restart
 neighbor {{ carrier_peer }} remote-as {{ pns.asn }}
 neighbor {{ carrier_peer }} description {{ pns.name }}
 neighbor {{ carrier_peer }} password {{ bgp_password }}
 neighbor {{ carrier_peer }} bfd profile {{ bfd_profile }}
 neighbor {{ ibgp_peer }} remote-as {{ asn }}
 neighbor {{ ibgp_peer }} description {{ xlink.description.value.split(" ")[0] }}
 neighbor {{ ibgp_peer }} bfd profile {{ bfd_profile }}
 neighbor {{ inetfw_ip }} remote-as {{ inetfw.asn.node.asn.value }}
 neighbor {{ inetfw_ip }} description {{ inetfw.name.value[:-1] }}
 neighbor {{ inetfw_ip }} password {{ bgp_password }}
 neighbor {{ inetfw_ip }} bfd profile {{ bfd_profile }}
 address-family ipv4 unicast
  network {{ pfx.p24 }}
  neighbor {{ carrier_peer }} route-map RM-CARRIER-IN in
  neighbor {{ carrier_peer }} maximum-prefix {{ max_prefix }} {{ max_prefix_pct }} warning-only
  neighbor {{ carrier_peer }} route-map RM-CARRIER-OUT out
  neighbor {{ ibgp_peer }} next-hop-self
  neighbor {{ inetfw_ip }} route-map RM-INETFW-IN in
  neighbor {{ inetfw_ip }} default-originate route-map RM-COND-DEFAULT
  neighbor {{ inetfw_ip }} route-map RM-INETFW-OUT out
 exit-address-family
exit
FRREOF
vtysh -f /etc/frr/frr.conf
echo "{{ name }} stand-in ready"
