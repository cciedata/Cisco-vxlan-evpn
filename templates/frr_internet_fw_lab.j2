{# Phase 3 (P3-44, P3-62..P3-65, P3-67): lab stand-in for an Internet FortiGate, as one POSIX shell script run in an FRR container
   (containerlab exec). Linux side: LACP aggregates, VLAN sub-interfaces, one kernel VRF for FortiOS VRF 1. FRR side mirrors
   internet_fw_config.j2: blackhole + network for the public /24, prefix-lists, route-maps, eBGP to the border leaves (TRANSIT)
   and to both ISP routers (edge VLAN), BFD 1000 x 3, graceful restart, password. Lab-only (P3-67): source NAT of the site's
   tenant summaries to the Internet FW NAT pool /25, so return traffic from the carriers reaches the tenant test host. #}
{# Approved constants: FortiOS values (PC3) reused; lab-only values (Phase 3, auto-approved) marked P3 #}
{% set table_vrf = 1 -%}
{% set transit_vrf = "TRANSIT" -%}
{% set bgp_password = "cisco123" -%}
{% set bfd_tx = 999 -%}{% set bfd_rx = 999 -%}{% set bfd_mult = 3 -%}
{% set seq_step = 10 -%}
{% set fw_host = 3 -%}
{% set edge_fw_host = 10 -%}
{% set dmz_gw_host = 1 -%}
{% set mtu = 9216 -%}
{% set table_base = 1000 -%}{# P3-63 #}
{% set bfd_profile = "FW-BFD" -%}{# P3-64 #}
{% set bond_mode = "802.3ad" -%}{# P3-65 #}
{# Values from the graph #}
{% set device = data.DcimDevice.edges[0].node -%}
{% set name = device.name.value -%}
{% set asn = device.asn.node.asn.value -%}
{% set site = device.location.node -%}
{% set site_name = site.name.value -%}
{% set fabric_asn = site.fabric_asn.node.asn.value -%}
{% set interfaces = device.interfaces.edges | map(attribute="node") | list -%}
{% set aggs = interfaces | selectattr("__typename", "equalto", "InterfacePortChannel") | list | sort(attribute="name.value") -%}
{% set transit_att = data.FabricAttachment.edges | map(attribute="node") | list | selectattr("vrf.node.name.value", "equalto", transit_vrf) | list | first -%}
{% set l2_site = data.FabricL2Vlan.edges | map(attribute="node") | list | selectattr("site.node.name.value", "equalto", site_name) | list | sort(attribute="vlan_id.value") -%}
{% set edge_vlan = l2_site | selectattr("switch_pair.node.name.value", "equalto", site_name ~ "-VPC-EDGE1-EDGE2") | list | first -%}
{% set dmz_vlans = l2_site | selectattr("switch_pair.node.name.value", "equalto", site_name ~ "-VPC-DMZ1-DMZ2") | list -%}
{% set isps = data.IspRouters.edges | map(attribute="node") | list | selectattr("location.node.name.value", "equalto", site_name) | list | sort(attribute="name.value") -%}
{% set pub_ns = namespace(p24=none, p25=none) -%}
{% for p in site.owned_prefixes.edges | map(attribute="node.prefix.value") | list %}{% if not p.startswith("10.") %}{% if p.split("/")[1] == "24" %}{% set pub_ns.p24 = p %}{% elif p.split("/")[1] == "25" %}{% set pub_ns.p25 = p %}{% endif %}{% endif %}{% endfor -%}
{% set summ_ns = namespace(pairs=[]) -%}
{% for v in site.vrfs.edges | map(attribute="node") | list | sort(attribute="name.value") %}{% for s in v.summaries.edges | map(attribute="node") | list | sort(attribute="prefix.value") %}{% if v.multisite.value or (s.site.node is not none and s.site.node.name.value == site_name) %}{% set summ_ns.pairs = summ_ns.pairs + [(v.name.value, s.prefix.value)] %}{% endif %}{% endfor %}{% endfor -%}
{% set site_summaries = summ_ns.pairs | rejectattr("0", "equalto", transit_vrf) | map(attribute="1") | unique | list -%}
{% macro host(p, n) %}{% set o = p.split("/")[0].split(".") %}{{ o[:3] | join(".") }}.{{ o[3] | int + n }}/{{ p.split("/")[1] }}{% endmacro -%}
{% set router_id = host(transit_att.prefix.node.prefix.value, fw_host) | ipaddress_interface("ip") -%}
{% set inside_if = transit_vrf ~ "-" ~ transit_att.vlan_id.value -%}
{% set outside_if = "OUTSIDE-" ~ edge_vlan.vlan_id.value -%}
{% set nat_first = host(pub_ns.p25, 1) | ipaddress_interface("ip") -%}
{% set nat_last = host(pub_ns.p25, (2 ** (32 - (pub_ns.p25.split("/")[1] | int))) - 2) | ipaddress_interface("ip") -%}
#!/bin/sh
# {{ name }}: lab stand-in for the Internet FortiGate (FRR in a Linux container). Rendered by Infrahub, do not edit.
# Mirrors the FortiOS routing config. Not mirrored: HA (one unit runs), mgmt1 (the container's eth0), firewall policies.
# Lab-only: source NAT of {{ site_summaries | join(", ") }} to the NAT pool {{ pub_ns.p25 }} on {{ outside_if }}.
set -eu
sysctl -qw net.ipv4.ip_forward=1
sysctl -qw net.ipv4.tcp_l3mdev_accept=1
# --- VRF (FortiOS VRF {{ table_vrf }} -> vrf{{ table_vrf }}, table {{ table_base + table_vrf }})
ip link add vrf{{ table_vrf }} type vrf table {{ table_base + table_vrf }} 2>/dev/null || true
ip link set vrf{{ table_vrf }} up
# --- aggregates (members that exist in the lab; the others stay absent)
{% for a in aggs %}
ip link add {{ a.name.value }} type bond mode {{ bond_mode }} 2>/dev/null || true
{% for m in a.members.edges | map(attribute="node.name.value") | list | sort %}
if [ -e /sys/class/net/{{ m }} ]; then ip link set {{ m }} down; ip link set {{ m }} mtu {{ mtu }}; ip link set {{ m }} master {{ a.name.value }}; ip link set {{ m }} up; fi
{% endfor %}
ip link set {{ a.name.value }} mtu {{ mtu }} up
{% endfor %}
# --- VLAN sub-interfaces: inside (TRANSIT), outside (edge VLAN), DMZ
{% set sub_ns = namespace(items=[(inside_if, "agg-inside", transit_att.vlan_id.value, host(transit_att.prefix.node.prefix.value, fw_host)),
                                  (outside_if, "agg-outside", edge_vlan.vlan_id.value, host(edge_vlan.prefix.node.prefix.value, edge_fw_host))]) -%}
{% for v in dmz_vlans %}{% set sub_ns.items = sub_ns.items + [("DMZ-" ~ v.vlan_id.value, "agg-dmz", v.vlan_id.value, host(v.prefix.node.prefix.value, dmz_gw_host))] %}{% endfor -%}
{% for ifn, parent, vid, addr in sub_ns.items %}
ip link add link {{ parent }} name {{ ifn }} type vlan id {{ vid }} 2>/dev/null || true
ip link set {{ ifn }} master vrf{{ table_vrf }}
ip addr replace {{ addr }} dev {{ ifn }}
ip link set {{ ifn }} mtu {{ mtu }} up
{% endfor %}
# --- lab-only source NAT toward the ISP routers (P3-67)
command -v iptables >/dev/null || apk add --no-cache iptables >/dev/null
{% for p in site_summaries %}
iptables -t nat -C POSTROUTING -s {{ p }} -o {{ outside_if }} -j SNAT --to-source {{ nat_first }}-{{ nat_last }} 2>/dev/null || iptables -t nat -A POSTROUTING -s {{ p }} -o {{ outside_if }} -j SNAT --to-source {{ nat_first }}-{{ nat_last }}
{% endfor %}
# --- routing daemons (watchfrr starts zebra and staticd; bgpd and bfdd are started here)
pgrep -x bfdd >/dev/null || /usr/lib/frr/bfdd -d -A 127.0.0.1
pgrep -x bgpd >/dev/null || /usr/lib/frr/bgpd -d -A 127.0.0.1
sleep 2
cat > /etc/frr/frr.conf <<'FRREOF'
hostname {{ name }}
service integrated-vtysh-config
!
vrf vrf{{ table_vrf }}
 ip route {{ pub_ns.p24 }} blackhole
exit-vrf
!
ip prefix-list PL-DEFAULT seq {{ seq_step }} permit 0.0.0.0/0
{% for p in site_summaries %}
ip prefix-list PL-{{ transit_vrf }}-SUMMARY seq {{ loop.index * seq_step }} permit {{ p }}
{% endfor %}
ip prefix-list PL-PUBLIC seq {{ seq_step }} permit {{ pub_ns.p24 }}
!
route-map RM-{{ transit_vrf }}-FROM-LEAF permit {{ seq_step }}
 match ip address prefix-list PL-{{ transit_vrf }}-SUMMARY
route-map RM-{{ transit_vrf }}-TO-LEAF permit {{ seq_step }}
 match ip address prefix-list PL-DEFAULT
route-map RM-FROM-ISP permit {{ seq_step }}
 match ip address prefix-list PL-DEFAULT
route-map RM-TO-ISP permit {{ seq_step }}
 match ip address prefix-list PL-PUBLIC
!
bfd
 profile {{ bfd_profile }}
  transmit-interval {{ bfd_tx }}
  receive-interval {{ bfd_rx }}
  detect-multiplier {{ bfd_mult }}
  no echo-mode
 exit
exit
!
{% set leaves = transit_att.switch_pair.node.members.edges | map(attribute="node.name.value") | list | sort_interface_list -%}
{% set nb_ns = namespace(items=[]) -%}
{% for k in [1, 2] %}{% set nb_ns.items = nb_ns.items + [(host(transit_att.prefix.node.prefix.value, k) | ipaddress_interface("ip"), fabric_asn, leaves[k - 1], inside_if, transit_vrf ~ "-FROM-LEAF", transit_vrf ~ "-TO-LEAF")] %}{% endfor -%}
{% for r in isps %}{% set nb_ns.items = nb_ns.items + [(r.interfaces.edges[0].node.ip_addresses.edges[0].node.address.value | ipaddress_interface("ip"), r.asn.node.asn.value, r.name.value, outside_if, "FROM-ISP", "TO-ISP")] %}{% endfor -%}
router bgp {{ asn }} vrf vrf{{ table_vrf }}
 bgp router-id {{ router_id }}
 bgp graceful-restart
{% for peer, ras, desc, src, rin, rout in nb_ns.items %}
 neighbor {{ peer }} remote-as {{ ras }}
 neighbor {{ peer }} description {{ desc }}
 neighbor {{ peer }} password {{ bgp_password }}
 neighbor {{ peer }} update-source {{ src }}
 neighbor {{ peer }} bfd profile {{ bfd_profile }}
{% endfor %}
 address-family ipv4 unicast
  network {{ pub_ns.p24 }}
{% for peer, ras, desc, src, rin, rout in nb_ns.items %}
  neighbor {{ peer }} route-map RM-{{ rin }} in
  neighbor {{ peer }} route-map RM-{{ rout }} out
{% endfor %}
 exit-address-family
exit
FRREOF
vtysh -f /etc/frr/frr.conf
echo "{{ name }} stand-in ready"
