{# Option 5 (D5-21): lab stand-in for the VPN-partner FortiGate, as one POSIX shell script run in an FRR container. Same query
   and derivation rules as vpn_fw_config.j2. Linux side: LACP aggregates, the PARTNER leg in kernel VRF vrf16 (FortiOS VRF 16),
   the OUTSIDE leg and the WAN loopback in the main table (VRF 0). FRR side mirrors the FortiOS routing: eBGP to the border leaves
   (0/0 in, the translated /28s out), the /28 blackholes and networks, statics to each partner's protected networks.
   Lab-only (P5): each route-based IKEv2 tunnel is a GRE tunnel to the partner stand-in; the partner source NAT is an iptables
   SNAT to the translated /28; the static 0/0 goes to ISP1's address instead of the VRRP VIP. #}
{% set partner_vrf = "PARTNER" -%}
{% set table_vrf = 16 -%}
{% set bgp_password = "cisco123" -%}
{% set bfd_tx = 999 -%}{% set bfd_rx = 999 -%}{% set bfd_mult = 3 -%}
{% set seq_step = 10 -%}
{% set fw_host = 3 -%}
{% set edge_fw_host = 12 -%}
{% set mtu = 9216 -%}
{% set wan_lo = "LO-WAN" -%}
{% set table_base = 1000 -%}{# P3-63 #}
{% set bfd_profile = "FW-BFD" -%}{# P3-64 #}
{% set bond_mode = "802.3ad" -%}{# P3-65 #}
{% set isp_gw_host = 2 -%}{# P5 (D5-21): ISP1's address on the edge VLAN, instead of the VRRP VIP .1 #}
{# Values from the graph #}
{% set device = data.DcimDevice.edges[0].node -%}
{% set name = device.name.value -%}
{% set asn = device.asn.node.asn.value -%}
{% set site = device.location.node -%}
{% set site_name = site.name.value -%}
{% set fabric_asn = site.fabric_asn.node.asn.value -%}
{% set interfaces = device.interfaces.edges | map(attribute="node") | list -%}
{% set aggs = interfaces | selectattr("__typename", "equalto", "InterfacePortChannel") | list | sort(attribute="name.value") -%}
{% set partner_att = data.FabricAttachment.edges | map(attribute="node") | list | selectattr("vrf.node.name.value", "equalto", partner_vrf) | list | first -%}
{% set l2_site = data.FabricL2Vlan.edges | map(attribute="node") | list | selectattr("site.node.name.value", "equalto", site_name) | list -%}
{% set edge_vlan = l2_site | selectattr("switch_pair.node.name.value", "equalto", site_name ~ "-VPC-EDGE1-EDGE2") | list | first -%}
{% set unit_ns = namespace(wan=none) -%}
{% for u in data.VpnUnits.edges | map(attribute="node") | list | selectattr("location.node.name.value", "equalto", site_name) | list %}{% for i in u.interfaces.edges | map(attribute="node") | list %}{% if i.ip_addresses is defined and i.ip_addresses.edges and i.name.value == wan_lo %}{% set unit_ns.wan = i.ip_addresses.edges[0].node.address.value %}{% endif %}{% endfor %}{% endfor -%}
{% set p_ns = namespace(items=[]) -%}
{% for p in data.FabricPartner.edges | map(attribute="node") | list | sort(attribute="name.value") %}{% for t in p.translated_prefixes.edges | map(attribute="node") | list %}{% if t.site.node is not none and t.site.node.name.value == site_name %}{% set p_ns.items = p_ns.items + [(p.name.value, p.description.value or "", p.peer_ip.value, p.protected_prefixes.value | sort, t.prefix.value)] %}{% endif %}{% endfor %}{% endfor -%}
{% set partners = p_ns.items -%}
{% macro host(p, n) %}{% set o = p.split("/")[0].split(".") %}{{ o[:3] | join(".") }}.{{ o[3] | int + n }}/{{ p.split("/")[1] }}{% endmacro -%}
{% set inside_if = partner_vrf ~ "-" ~ partner_att.vlan_id.value -%}
{% set outside_if = "OUTSIDE-" ~ edge_vlan.vlan_id.value -%}
{% set outside_ip = host(edge_vlan.prefix.node.prefix.value, edge_fw_host) -%}
{% set isp_gw = host(edge_vlan.prefix.node.prefix.value, isp_gw_host) | ipaddress_interface("ip") -%}
{% set wan_ip = unit_ns.wan | ipaddress_interface("ip") | string -%}
{% set router_id = host(partner_att.prefix.node.prefix.value, fw_host) | ipaddress_interface("ip") -%}
#!/bin/sh
# {{ name }}: lab stand-in for the VPN-partner FortiGate (FRR in a Linux container). Rendered by Infrahub, do not edit.
# Mirrors the FortiOS routing config. Not mirrored: HA (unit 2 runs with its data ports down), mgmt1 (the container's eth0),
# firewall policies. Lab-only: GRE instead of IPsec per partner, iptables SNAT to each translated /28, 0/0 via {{ isp_gw }}.
set -eu
sysctl -qw net.ipv4.ip_forward=1
sysctl -qw net.ipv4.tcp_l3mdev_accept=1
ip route del default dev eth0 2>/dev/null || true
# --- VRF (FortiOS VRF {{ table_vrf }} -> vrf{{ table_vrf }}, table {{ table_base + table_vrf }}); VRF 0 is the main table
ip link add vrf{{ table_vrf }} type vrf table {{ table_base + table_vrf }} 2>/dev/null || true
ip link set vrf{{ table_vrf }} up
# --- aggregates (members that exist in the lab; the others stay absent)
{% for a in aggs %}
ip link add {{ a.name.value }} type bond mode {{ bond_mode }} 2>/dev/null || true
{% for m in a.members.edges | map(attribute="node.name.value") | list | sort %}
if [ -e /sys/class/net/{{ m }} ]; then ip link set {{ m }} down; ip link set {{ m }} mtu {{ mtu }}; ip link set {{ m }} master {{ a.name.value }}; ip link set {{ m }} up; fi
{% endfor %}
ip link set {{ a.name.value }} mtu {{ mtu }} up
{% endfor %}
# --- inside leg (VRF {{ table_vrf }}), outside leg and WAN loopback (main table)
ip link add link agg-inside name {{ inside_if }} type vlan id {{ partner_att.vlan_id.value }} 2>/dev/null || true
ip link set {{ inside_if }} master vrf{{ table_vrf }}
ip addr replace {{ host(partner_att.prefix.node.prefix.value, fw_host) }} dev {{ inside_if }}
ip link set {{ inside_if }} mtu {{ mtu }} up
ip link add link agg-outside name {{ outside_if }} type vlan id {{ edge_vlan.vlan_id.value }} 2>/dev/null || true
ip addr replace {{ outside_ip }} dev {{ outside_if }}
ip link set {{ outside_if }} mtu {{ mtu }} up
ip link add {{ wan_lo }} type dummy 2>/dev/null || true
ip addr replace {{ wan_ip }}/32 dev {{ wan_lo }}
ip link set {{ wan_lo }} up
# --- one tunnel per partner (lab-only GRE; FortiOS: route-based IKEv2 on {{ wan_lo }}) in VRF {{ table_vrf }}, SNAT to its /28
command -v iptables >/dev/null || apk add --no-cache iptables >/dev/null 2>&1 || echo "WARNING: iptables not available (no package mirror): partner source NAT not set"
{% for pname, pdesc, peer, protected, nat in partners %}
{% set nat_first = host(nat, 1) | ipaddress_interface("ip") -%}
{% set nat_last = host(nat, (2 ** (32 - (nat.split("/")[1] | int))) - 2) | ipaddress_interface("ip") -%}
ip tunnel add {{ pname }} mode gre local {{ wan_ip }} remote {{ peer | ipaddress_interface("ip") }} ttl 64 2>/dev/null || true
ip link set {{ pname }} master vrf{{ table_vrf }}
ip link set {{ pname }} up
if command -v iptables >/dev/null; then iptables -t nat -C POSTROUTING -o {{ pname }} -j SNAT --to-source {{ nat_first }}-{{ nat_last }} 2>/dev/null || iptables -t nat -A POSTROUTING -o {{ pname }} -j SNAT --to-source {{ nat_first }}-{{ nat_last }}; fi
{% endfor %}
# --- routing daemons (watchfrr starts zebra and staticd; bgpd and bfdd are started here)
pgrep -x bfdd >/dev/null || /usr/lib/frr/bfdd -d -A 127.0.0.1
pgrep -x bgpd >/dev/null || /usr/lib/frr/bgpd -d -A 127.0.0.1
sleep 2
cat > /etc/frr/frr.conf <<'FRREOF'
hostname {{ name }}
service integrated-vtysh-config
!
ip route 0.0.0.0/0 {{ isp_gw }}
vrf vrf{{ table_vrf }}
{% for pname, pdesc, peer, protected, nat in partners %}
{% for p in protected %}
 ip route {{ p }} {{ pname }}
{% endfor %}
 ip route {{ nat }} blackhole
{% endfor %}
exit-vrf
!
ip prefix-list PL-DEFAULT seq {{ seq_step }} permit 0.0.0.0/0
{% for pname, pdesc, peer, protected, nat in partners %}
ip prefix-list PL-{{ partner_vrf }}-NAT seq {{ loop.index * seq_step }} permit {{ nat }}
{% endfor %}
!
route-map RM-{{ partner_vrf }}-FROM-LEAF permit {{ seq_step }}
 match ip address prefix-list PL-DEFAULT
route-map RM-{{ partner_vrf }}-TO-LEAF permit {{ seq_step }}
 match ip address prefix-list PL-{{ partner_vrf }}-NAT
!
bfd
 profile {{ bfd_profile }}
  transmit-interval {{ bfd_tx }}
  receive-interval {{ bfd_rx }}
  detect-multiplier {{ bfd_mult }}
  no echo-mode
 exit
exit
!
{% set leaves = partner_att.switch_pair.node.members.edges | map(attribute="node.name.value") | list | sort_interface_list %}
router bgp {{ asn }} vrf vrf{{ table_vrf }}
 bgp router-id {{ router_id }}
 bgp graceful-restart
{% for k in [1, 2] %}
{% set peer = host(partner_att.prefix.node.prefix.value, k) | ipaddress_interface("ip") %}
 neighbor {{ peer }} remote-as {{ fabric_asn }}
 neighbor {{ peer }} description {{ leaves[k - 1] }}
 neighbor {{ peer }} password {{ bgp_password }}
 neighbor {{ peer }} update-source {{ inside_if }}
 neighbor {{ peer }} bfd profile {{ bfd_profile }}
{% endfor %}
 address-family ipv4 unicast
{% for pname, pdesc, peer, protected, nat in partners %}
  network {{ nat }}
{% endfor %}
{% for k in [1, 2] %}
{% set peer = host(partner_att.prefix.node.prefix.value, k) | ipaddress_interface("ip") %}
  neighbor {{ peer }} route-map RM-{{ partner_vrf }}-FROM-LEAF in
  neighbor {{ peer }} route-map RM-{{ partner_vrf }}-TO-LEAF out
{% endfor %}
 exit-address-family
exit
FRREOF
vtysh -f /etc/frr/frr.conf
echo "{{ name }} stand-in ready"
