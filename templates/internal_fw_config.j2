{# Internal FortiGate (FortiOS 7.6.7), A/P HA, single VDOM, one VRF per tenant + TRANSIT (VRF 1).
   Routing only (no policies, no NAT). Tenant VRFs reach TRANSIT through BGP leak-target over NPU vlink pairs (star). #}
{%- if data.FabricDesign.count != 1 %}{{ missing_FabricDesign_object() }}{% endif -%}
{%- set fd = data.FabricDesign.edges[0].node -%}
{%- if fd.transit_vrf.value is none %}{{ missing_FabricDesign_transit_vrf() }}{% endif -%}
{%- if fd.internal_fw_ha_group_base.value is none %}{{ missing_FabricDesign_internal_fw_ha_group_base() }}{% endif -%}
{%- if fd.fw_ha_priority.value is none %}{{ missing_FabricDesign_fw_ha_priority() }}{% endif -%}
{%- if fd.ha_heartbeat_priority.value is none %}{{ missing_FabricDesign_ha_heartbeat_priority() }}{% endif -%}
{%- if fd.ha_monitor_aggregates.value is none %}{{ missing_FabricDesign_ha_monitor_aggregates() }}{% endif -%}
{%- if fd.ha_mode.value is none %}{{ missing_FabricDesign_ha_mode() }}{% endif -%}
{%- if fd.ha_session_pickup.value is none %}{{ missing_FabricDesign_ha_session_pickup() }}{% endif -%}
{%- if fd.ha_preempt.value is none %}{{ missing_FabricDesign_ha_preempt() }}{% endif -%}
{%- if fd.ha_reserved_mgmt_interface.value is none %}{{ missing_FabricDesign_ha_reserved_mgmt_interface() }}{% endif -%}
{%- if fd.oob_gateway_host.value is none %}{{ missing_FabricDesign_oob_gateway_host() }}{% endif -%}
{%- if fd.bfd_interval_ms.value is none %}{{ missing_FabricDesign_bfd_interval_ms() }}{% endif -%}
{%- if fd.bfd_multiplier.value is none %}{{ missing_FabricDesign_bfd_multiplier() }}{% endif -%}
{%- if fd.bfd_min_rx_ms.value is none %}{{ missing_FabricDesign_bfd_min_rx_ms() }}{% endif -%}
{%- if fd.route_policy_seq_step.value is none %}{{ missing_FabricDesign_route_policy_seq_step() }}{% endif -%}
{%- if fd.attachment_device_host.value is none %}{{ missing_FabricDesign_attachment_device_host() }}{% endif -%}
{%- if fd.attachment_leaf_hosts.value is none %}{{ missing_FabricDesign_attachment_leaf_hosts() }}{% endif -%}
{%- if fd.internal_fw_block_third_octet.value is none %}{{ missing_FabricDesign_internal_fw_block_third_octet() }}{% endif -%}
{%- if fd.fw_leak_fourth_octet_base.value is none %}{{ missing_FabricDesign_fw_leak_fourth_octet_base() }}{% endif -%}
{%- if fd.fw_prepend_home_site.value is none %}{{ missing_FabricDesign_fw_prepend_home_site() }}{% endif -%}
{%- if fd.fw_prepend_count.value is none %}{{ missing_FabricDesign_fw_prepend_count() }}{% endif -%}
{%- if fd.mtu_fw_subinterface.value is none %}{{ missing_FabricDesign_mtu_fw_subinterface() }}{% endif -%}
{%- if fd.fw_aspath_action.value is none %}{{ missing_FabricDesign_fw_aspath_action() }}{% endif -%}
{%- if fd.fw_allow_subnet_overlap.value is none %}{{ missing_FabricDesign_fw_allow_subnet_overlap() }}{% endif -%}
{%- if fd.fw_bgp_graceful_restart.value is none %}{{ missing_FabricDesign_fw_bgp_graceful_restart() }}{% endif -%}
{%- if fd.lacp_mode.value is none %}{{ missing_FabricDesign_lacp_mode() }}{% endif -%}
{%- if fd.fw_mgmt_allowed_access.value is none %}{{ missing_FabricDesign_fw_mgmt_allowed_access() }}{% endif -%}
{%- if fd.internal_fw_vlink_prefix_length.value is none %}{{ missing_FabricDesign_internal_fw_vlink_prefix_length() }}{% endif -%}
{%- if fd.internal_fw_vlink_tenant_host.value is none %}{{ missing_FabricDesign_internal_fw_vlink_tenant_host() }}{% endif -%}
{%- if fd.internal_fw_vlink_transit_host.value is none %}{{ missing_FabricDesign_internal_fw_vlink_transit_host() }}{% endif -%}
{%- if fd.internal_fw_vlink_vlan_rule.value is none %}{{ missing_FabricDesign_internal_fw_vlink_vlan_rule() }}{% endif -%}
{%- if fd.internal_fw_npu_vlink.value is none %}{{ missing_FabricDesign_internal_fw_npu_vlink() }}{% endif -%}
{%- if fd.fw_bfd.value is none %}{{ missing_FabricDesign_fw_bfd() }}{% endif -%}
{%- if fd.fw_mtu_override.value is none %}{{ missing_FabricDesign_fw_mtu_override() }}{% endif -%}
{%- if fd.attachment_bgp_bfd.value is none %}{{ missing_FabricDesign_attachment_bgp_bfd() }}{% endif -%}
{%- if fd.fw_router_id_source.value is none %}{{ missing_FabricDesign_fw_router_id_source() }}{% endif -%}
{# Constants, read from FabricDesign #}
{% set transit_vrf = fd.transit_vrf.value -%}
{% set ha_group_base = fd.internal_fw_ha_group_base.value -%}
{% set ha_priority = fd.fw_ha_priority.value -%}
{% set ha_hb_weight = fd.ha_heartbeat_priority.value -%}
{% set bfd_tx = fd.bfd_interval_ms.value -%}{% set bfd_rx = fd.bfd_min_rx_ms.value -%}{% set bfd_mult = fd.bfd_multiplier.value -%}
{% set seq_step = fd.route_policy_seq_step.value -%}
{% set fw_host = fd.attachment_device_host.value -%}
{% set leak_third = fd.internal_fw_block_third_octet.value -%}{% set leak_base = fd.fw_leak_fourth_octet_base.value -%}
{% set home_site = fd.fw_prepend_home_site.value -%}
{% set prepend_count = fd.fw_prepend_count.value -%}
{% set mtu = fd.mtu_fw_subinterface.value -%}
{% set vlink_plen = fd.internal_fw_vlink_prefix_length.value -%}{% set vlink_tenant_host = fd.internal_fw_vlink_tenant_host.value -%}{% set vlink_transit_host = fd.internal_fw_vlink_transit_host.value -%}
{% set aspath_action = fd.fw_aspath_action.value -%}   {#- every route the FW sends to a leaf carries only the FW AS (no fabric AS in the path, no loop drop) -#}
{# Values from the graph #}
{% set device = data.DcimDevice.edges[0].node -%}
{% set name = device.name.value -%}
{% set unit = name[-1] | int -%}
{% set asn = device.asn.node.asn.value -%}
{% set site = device.location.node -%}
{% set site_name = site.name.value -%}
{% set fabric_asn = site.fabric_asn.node.asn.value -%}
{# Per-site FabricDesign fields (dc1_/dc2_): a site without its field fails on the lookup, naming the field #}
{% set site_key = site_name | lower -%}
{%- if fd[site_key ~ "_fw_ha_group_offset"].value is none %}{{ missing_FabricDesign_fw_ha_group_offset() }}{% endif -%}
{%- if fd[site_key ~ "_attachment_bgp_password"].value is none %}{{ missing_FabricDesign_attachment_bgp_password() }}{% endif -%}
{%- if ha_priority[unit | string] is not defined %}{{ missing_FabricDesign_fw_ha_priority_for_unit() }}{% endif -%}
{% set ha_site_offset = fd[site_key ~ "_fw_ha_group_offset"].value -%}
{% set bgp_password = fd[site_key ~ "_attachment_bgp_password"].value -%}
{% set interfaces = device.interfaces.edges | map(attribute="node") | list -%}
{% set physical = interfaces | selectattr("__typename", "equalto", "InterfacePhysical") | list -%}
{% set mgmt = physical | selectattr("role.value", "equalto", "management") | list | first -%}
{% set aggs = interfaces | selectattr("__typename", "equalto", "InterfacePortChannel") | list | sort(attribute="name.value") -%}
{% set fw_ports = physical | selectattr("role.value", "equalto", "peering") | list -%}
{# Hardware ports from the device type (HA heartbeat ports, NPU vlink pair: tenant side, TRANSIT side) #}
{%- if device.device_type.node.ha_ports.value is none %}{{ missing_DcimDeviceType_ha_ports() }}{% endif -%}
{%- if device.device_type.node.vrf_leak_link_ports.value is none %}{{ missing_DcimDeviceType_vrf_leak_link_ports() }}{% endif -%}
{% set ha_ports = device.device_type.node.ha_ports.value -%}
{% set leak_ports = device.device_type.node.vrf_leak_link_ports.value -%}
{% set attachments = data.FabricAttachment.edges | map(attribute="node") | list | sort(attribute="vlan_id.value") -%}
{% set tenants = attachments | rejectattr("vrf.node.name.value", "equalto", transit_vrf) | list -%}
{% set transit_att = attachments | selectattr("vrf.node.name.value", "equalto", transit_vrf) | list | first -%}
{# FortiOS VRF ids and the prepend flag come from the VRF objects (FabricVRF) #}
{% for a in attachments %}{% if a.vrf.node.fortios_vrf_id.value is none %}{{ missing_FabricVRF_fortios_vrf_id() }}{% endif %}{% endfor -%}
{% for v in site.vrfs.edges | map(attribute="node") | list %}{% if v.fw_prepend.value is none %}{{ missing_FabricVRF_fw_prepend() }}{% endif %}{% endfor -%}
{% set transit_vrf_id = transit_att.vrf.node.fortios_vrf_id.value -%}
{% set prepended_vrfs = site.vrfs.edges | map(attribute="node") | selectattr("fw_prepend.value") | map(attribute="name.value") | list -%}
{# Sub-interface parents and the HA monitor list are read from the interface objects #}
{% set subif_objs = interfaces | selectattr("__typename", "equalto", "InterfaceVirtual") | list -%}
{% macro parent_of(n) %}{% set s = subif_objs | selectattr("name.value", "equalto", n) | list | first %}{% if s is not defined or s.parent_interface.node is none %}{{ missing_InterfaceVirtual_parent_interface() }}{% else %}{{ s.parent_interface.node.name.value }}{% endif %}{% endmacro -%}
{% set pc_names = aggs | selectattr("role.value", "equalto", "peering") | map(attribute="name.value") | list -%}
{% set mon_ns = namespace(names=[]) -%}
{% for att in attachments %}{% set p = parent_of(att.vrf.node.name.value ~ "-" ~ att.vlan_id.value) | string %}{% if p in pc_names and p not in mon_ns.names %}{% set mon_ns.names = mon_ns.names + [p] %}{% endif %}{% endfor -%}
{% for p in pc_names %}{% if p not in mon_ns.names %}{% set mon_ns.names = mon_ns.names + [p] %}{% endif %}{% endfor -%}
{% set ha_monitor = mon_ns.names -%}
{# Summaries per VRF for this site (same rule as the service leaf): owned by this site, or all of a multisite VRF #}
{% set summ_ns = namespace(pairs=[]) -%}
{% for v in site.vrfs.edges | map(attribute="node") | list | sort(attribute="name.value") %}{% for s in v.summaries.edges | map(attribute="node") | list | sort(attribute="prefix.value") %}{% if v.multisite.value or (s.site.node is not none and s.site.node.name.value == site_name) %}{% set summ_ns.pairs = summ_ns.pairs + [(v.name.value, s.prefix.value)] %}{% endif %}{% endfor %}{% endfor -%}
{% set site_summaries = summ_ns.pairs | rejectattr("0", "equalto", transit_vrf) | map(attribute="1") | unique | list -%}
{% set is_standby_site = site_name != home_site -%}
{% macro net(p) %}{{ p | ipaddress_interface("network") | string }}{% endmacro -%}
{% macro ipmask(addr) %}{{ addr | ipaddress_interface("ip") }} {{ addr | ipaddress_interface("netmask") }}{% endmacro -%}
{% macro pfxmask(p) %}{{ p.split("/")[0] }} {{ p | ipaddress_interface("netmask") }}{% endmacro -%}
{% macro host(p, n) %}{% set o = p.split("/")[0].split(".") %}{{ o[:3] | join(".") }}.{{ o[3] | int + n }}/{{ p.split("/")[1] }}{% endmacro -%}
{# NPU vlink subnet of a tenant (same rule as generators/fabric_site.py build_fw): the attachment's slot = its fourth octet / attachment
   size; vlink subnet = <infra>.<leak_third>.<leak_base + slot * vlink size>/<vlink_plen>; n = host number in that subnet #}
{% macro leak(p, n) %}{% set o = p.split("/")[0].split(".") %}{% set slot = (o[3] | int) // (2 ** (32 - (p.split("/")[1] | int))) %}{{ o[:2] | join(".") }}.{{ leak_third }}.{{ leak_base + slot * (2 ** (32 - vlink_plen)) + n }}/{{ vlink_plen }}{% endmacro -%}
{% macro vlink_vlan(att) %}{% if fd.internal_fw_vlink_vlan_rule.value == "tenant_fortios_vrf_id" %}{{ att.vrf.node.fortios_vrf_id.value }}{% else %}{{ unsupported_FabricDesign_internal_fw_vlink_vlan_rule() }}{% endif %}{% endmacro -%}
{% macro router_id(att) %}{% if fd.fw_router_id_source.value == "attachment_fw_address" %}{{ host(att.prefix.node.prefix.value, fw_host) | ipaddress_interface("ip") }}{% else %}{{ unsupported_FabricDesign_fw_router_id_source() }}{% endif %}{% endmacro -%}
config system global
    set hostname "{{ name }}"
    set single-vdom-npuvlink {{ "enable" if fd.internal_fw_npu_vlink.value else "disable" }}
end
config system settings
    set allow-subnet-overlap {{ "enable" if fd.fw_allow_subnet_overlap.value else "disable" }}
    set bfd {{ "enable" if fd.fw_bfd.value else "disable" }}
    set bfd-desired-min-tx {{ bfd_tx }}
    set bfd-required-min-rx {{ bfd_rx }}
    set bfd-detect-mult {{ bfd_mult }}
end
config system ha
    set group-id {{ ha_group_base + ha_site_offset }}
    set group-name "{{ name[:-1] }}-HA"
    set mode {{ fd.ha_mode.value }}
    set hbdev{% for p in ha_ports %} "{{ p }}" {{ ha_hb_weight }}{% endfor %}

    set session-pickup {{ "enable" if fd.ha_session_pickup.value else "disable" }}
    set override {{ "enable" if fd.ha_preempt.value else "disable" }}
    set priority {{ ha_priority[unit | string] }}
{% if fd.ha_monitor_aggregates.value %}
    set monitor{% for m in ha_monitor %} "{{ m }}"{% endfor %}

{% endif %}
{% if fd.ha_reserved_mgmt_interface.value %}
    set ha-mgmt-status enable
    config ha-mgmt-interfaces
        edit 1
            set interface "{{ mgmt.name.value }}"
            set gateway {{ host(net(mgmt.ip_addresses.edges[0].node.address.value), fd.oob_gateway_host.value) | ipaddress_interface("ip") }}
        next
    end
{% else %}
    set ha-mgmt-status disable
{% endif %}
end
config system interface
    edit "{{ mgmt.name.value }}"
        set ip {{ ipmask(mgmt.ip_addresses.edges[0].node.address.value) }}
        set allowaccess {{ fd.fw_mgmt_allowed_access.value | join(" ") }}
        set description "{{ mgmt.description.value }}"
    next
{% for p in fw_ports | sort(attribute="name.value") %}
    edit "{{ p.name.value }}"
        set description "{{ p.description.value }}"
        set mtu-override {{ "enable" if fd.fw_mtu_override.value else "disable" }}
        set mtu {{ p.mtu.value }}
    next
{% endfor %}
{% for a in aggs %}
    edit "{{ a.name.value }}"
        set type aggregate
        set member{% for m in a.members.edges | map(attribute="node.name.value") | list | sort %} "{{ m }}"{% endfor %}

        set lacp-mode {{ fd.lacp_mode.value }}
        set description "{{ a.description.value }}"
        set mtu-override {{ "enable" if fd.fw_mtu_override.value else "disable" }}
        set mtu {{ a.mtu.value }}
    next
{% endfor %}
{% for att in attachments %}
{% set v = att.vrf.node.name.value %}
    edit "{{ v }}-{{ att.vlan_id.value }}"
        set vrf {{ att.vrf.node.fortios_vrf_id.value }}
        set interface "{{ parent_of(v ~ "-" ~ att.vlan_id.value) }}"
        set vlanid {{ att.vlan_id.value }}
        set ip {{ ipmask(host(att.prefix.node.prefix.value, fw_host)) }}
        set description "{{ att.name.value }}"
        set mtu-override {{ "enable" if fd.fw_mtu_override.value else "disable" }}
        set mtu {{ mtu }}
        set bfd {{ "enable" if fd.attachment_bgp_bfd.value else "disable" }}
    next
{% endfor %}
{% for att in tenants %}
{% set v = att.vrf.node.name.value %}
    edit "LK-{{ v }}"
        set vrf {{ att.vrf.node.fortios_vrf_id.value }}
        set interface "{{ leak_ports[0] }}"
        set vlanid {{ vlink_vlan(att) }}
        set ip {{ ipmask(leak(att.prefix.node.prefix.value, vlink_tenant_host)) }}
        set description "vlink {{ v }} <-> {{ transit_vrf }}"
    next
    edit "LK-T-{{ v }}"
        set vrf {{ transit_vrf_id }}
        set interface "{{ leak_ports[1] }}"
        set vlanid {{ vlink_vlan(att) }}
        set ip {{ ipmask(leak(att.prefix.node.prefix.value, vlink_transit_host)) }}
        set description "vlink {{ v }} <-> {{ transit_vrf }}"
    next
{% endfor %}
end
config router prefix-list
    edit "PL-DEFAULT"
        config rule
            edit {{ seq_step }}
                set prefix 0.0.0.0 0.0.0.0
            next
        end
    next
{% for att in tenants %}
{% set v = att.vrf.node.name.value %}
    edit "PL-{{ v }}-SUMMARY"
        config rule
{% for p in summ_ns.pairs | selectattr("0", "equalto", v) | map(attribute="1") | list %}
            edit {{ loop.index * seq_step }}
                set prefix {{ pfxmask(p) }}
            next
{% endfor %}
        end
    next
{% endfor %}
    edit "PL-{{ transit_vrf }}-SUMMARY"
        config rule
{% for p in site_summaries %}
            edit {{ loop.index * seq_step }}
                set prefix {{ pfxmask(p) }}
            next
{% endfor %}
        end
    next
{% if is_standby_site %}
    edit "PL-{{ transit_vrf }}-SUMMARY-PREPEND"
        config rule
{% for p in summ_ns.pairs | selectattr("0", "in", prepended_vrfs) | map(attribute="1") | unique | list %}
            edit {{ loop.index * seq_step }}
                set prefix {{ pfxmask(p) }}
            next
{% endfor %}
        end
    next
{% endif %}
end
config router route-map
{% for att in tenants %}
{% set v = att.vrf.node.name.value %}
    edit "RM-{{ v }}-FROM-LEAF"
        config rule
            edit {{ seq_step }}
                set match-ip-address "PL-{{ v }}-SUMMARY"
            next
        end
    next
    edit "RM-{{ v }}-TO-LEAF"
        config rule
            edit {{ seq_step }}
                set match-ip-address "PL-DEFAULT"
                set set-aspath-action {{ aspath_action }}
                set set-aspath "{{ ([asn] * (prepend_count if is_standby_site and v in prepended_vrfs else 1)) | join(' ') }}"
            next
        end
    next
    edit "RM-LEAK-{{ v }}-TO-{{ transit_vrf }}"
        config rule
            edit {{ seq_step }}
                set match-ip-address "PL-{{ v }}-SUMMARY"
            next
        end
    next
    edit "RM-LEAK-{{ transit_vrf }}-TO-{{ v }}"
        config rule
            edit {{ seq_step }}
                set match-ip-address "PL-DEFAULT"
            next
        end
    next
{% endfor %}
    edit "RM-{{ transit_vrf }}-FROM-LEAF"
        config rule
            edit {{ seq_step }}
                set match-ip-address "PL-DEFAULT"
            next
        end
    next
    edit "RM-{{ transit_vrf }}-TO-LEAF"
        config rule
{% if is_standby_site %}
            edit {{ seq_step }}
                set match-ip-address "PL-{{ transit_vrf }}-SUMMARY-PREPEND"
                set set-aspath-action {{ aspath_action }}
                set set-aspath "{{ ([asn] * prepend_count) | join(' ') }}"
            next
            edit {{ 2 * seq_step }}
                set match-ip-address "PL-{{ transit_vrf }}-SUMMARY"
                set set-aspath-action {{ aspath_action }}
                set set-aspath "{{ asn }}"
            next
{% else %}
            edit {{ seq_step }}
                set match-ip-address "PL-{{ transit_vrf }}-SUMMARY"
                set set-aspath-action {{ aspath_action }}
                set set-aspath "{{ asn }}"
            next
{% endif %}
        end
    next
end
config router bgp
    set as {{ asn }}
    set router-id {{ router_id(transit_att) }}
    set graceful-restart {{ "enable" if fd.fw_bgp_graceful_restart.value else "disable" }}
    config neighbor
{% for att in attachments %}
{% set v = att.vrf.node.name.value %}
{% set leaves = att.switch_pair.node.members.edges | map(attribute="node.name.value") | list | sort_interface_list %}
{% for k in fd.attachment_leaf_hosts.value %}
        edit "{{ host(att.prefix.node.prefix.value, k) | ipaddress_interface("ip") }}"
            set description "{{ leaves[loop.index0] }}"
            set remote-as {{ fabric_asn }}
            set interface "{{ v }}-{{ att.vlan_id.value }}"
            set update-source "{{ v }}-{{ att.vlan_id.value }}"
            set bfd {{ "enable" if fd.attachment_bgp_bfd.value else "disable" }}
            set capability-graceful-restart {{ "enable" if fd.fw_bgp_graceful_restart.value else "disable" }}
            set password {{ bgp_password }}
            set route-map-in "RM-{{ v }}-FROM-LEAF"
            set route-map-out "RM-{{ v }}-TO-LEAF"
        next
{% endfor %}
{% endfor %}
    end
    config vrf
{% for att in tenants %}
{% set v = att.vrf.node.name.value %}
        edit "{{ att.vrf.node.fortios_vrf_id.value }}"
            config leak-target
                edit "{{ transit_vrf_id }}"
                    set route-map "RM-LEAK-{{ v }}-TO-{{ transit_vrf }}"
                    set interface "LK-{{ v }}"
                next
            end
        next
{% endfor %}
        edit "{{ transit_vrf_id }}"
            config leak-target
{% for att in tenants %}
{% set v = att.vrf.node.name.value %}
                edit "{{ att.vrf.node.fortios_vrf_id.value }}"
                    set route-map "RM-LEAK-{{ transit_vrf }}-TO-{{ v }}"
                    set interface "LK-T-{{ v }}"
                next
{% endfor %}
            end
        next
    end
end
